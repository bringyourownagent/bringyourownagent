<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests of the wallet 0.1: routing, limits, the gate integration, WAV measuring, the stdio framing and the
       host relay, and the DPAPI round trip. The end-to-end test with a real browser is in ../e2e. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\Byoa.Wallet.Core\Byoa.Wallet.Core.csproj" />
    <ProjectReference Include="..\..\host\Byoa.Wallet.Host\Byoa.Wallet.Host.csproj" />
    <ProjectReference Include="..\..\core\Byoa.Wallet.Providers\Byoa.Wallet.Providers.csproj" />
    <ProjectReference Include="..\..\desktop\Byoa.Wallet.Desktop\Byoa.Wallet.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
