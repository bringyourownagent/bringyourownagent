<Project Sdk="Microsoft.NET.Sdk">

  <!-- Byoa.Wallet.exe: the tray app "Agent wallet" (Avalonia). It runs the wallet engine, serves the native host
       over a per-user named pipe, and shows the notice, the consent window and the settings. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Byoa.Wallet</AssemblyName>
    <!-- The file description: what Windows and browsers call the app, e.g. Chrome's "Open Agent wallet?" for a link. -->
    <AssemblyTitle>Agent wallet</AssemblyTitle>
    <RootNamespace>Byoa.Wallet.Desktop</RootNamespace>
    <!-- Windows builds default to win-x64; a macOS build names its own runtime on the command line (-r osx-arm64). -->
    <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- The PNGs beside the program too: the register switch writes the desktop icons without a window, so it cannot use Avalonia's loader. -->
    <Content Include="Assets\icon-*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             Link="icons\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\Byoa.Wallet.Core\Byoa.Wallet.Core.csproj" />
    <ProjectReference Include="..\..\core\Byoa.Wallet.Providers\Byoa.Wallet.Providers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Byoa.Wallet.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <!-- The Windows installer (Setup.exe), the Start menu entry and "Check for updates"; vpk packs the release (wallet\packaging\make-package.ps1 -Installer). -->
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <!-- Windows, macOS and Linux (the Everywhere page is Windows only for now); the Windows-only classes carry their own SupportedOSPlatform. -->

</Project>
