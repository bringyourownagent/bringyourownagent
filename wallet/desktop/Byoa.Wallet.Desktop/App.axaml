<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Byoa.Wallet.Desktop.App"
             RequestedThemeVariant="Light">
  <!-- Colours and type follow the BYOA design system (DESIGN.md of the site): three inks (sign blue, signal orange,
       board black) on enamel white and quiet desktop neutrals; Barlow for controls, Barlow Semi Condensed for signs. -->
  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="SignColor">#1c2f73</Color>
      <Color x:Key="SignalColor">#e8552e</Color>
      <Color x:Key="SignalDeepColor">#c8401c</Color>
      <Color x:Key="SignalDarkColor">#a93514</Color>
      <Color x:Key="InkColor">#13151b</Color>
      <Color x:Key="Ink2Color">#3c4150</Color>
      <Color x:Key="MutedColor">#5a6070</Color>
      <Color x:Key="RuleColor">#c6cbd5</Color>
      <Color x:Key="WinBarColor">#f2f3f6</Color>
      <Color x:Key="WinRuleColor">#dde1e8</Color>
      <Color x:Key="FieldColor">#f4f5f8</Color>
      <Color x:Key="ConcourseColor">#e7e9ed</Color>

      <SolidColorBrush x:Key="Sign" Color="#1c2f73" />
      <SolidColorBrush x:Key="SignHover" Color="#142359" />
      <SolidColorBrush x:Key="SignMuted" Color="#c9d1ee" />
      <SolidColorBrush x:Key="Signal" Color="#e8552e" />
      <SolidColorBrush x:Key="SignalDeep" Color="#c8401c" />
      <SolidColorBrush x:Key="SignalDark" Color="#a93514" />
      <SolidColorBrush x:Key="Ink" Color="#13151b" />
      <SolidColorBrush x:Key="Ink2" Color="#3c4150" />
      <SolidColorBrush x:Key="Muted" Color="#5a6070" />
      <SolidColorBrush x:Key="Rule" Color="#c6cbd5" />
      <SolidColorBrush x:Key="WinBar" Color="#f2f3f6" />
      <SolidColorBrush x:Key="WinRule" Color="#dde1e8" />
      <SolidColorBrush x:Key="Field" Color="#f4f5f8" />
      <SolidColorBrush x:Key="Enamel" Color="#ffffff" />
      <SolidColorBrush x:Key="Concourse" Color="#e7e9ed" />
      <SolidColorBrush x:Key="ChipGrey" Color="#e6e8ed" />
      <SolidColorBrush x:Key="BadgeGrey" Color="#eceef2" />
      <SolidColorBrush x:Key="DenyBorder" Color="#c3c8d2" />
      <SolidColorBrush x:Key="Outline" Color="#9aa1af" />

      <FontFamily x:Key="Body">avares://Byoa.Wallet/Assets/Fonts#Barlow</FontFamily>
      <FontFamily x:Key="SignFace">avares://Byoa.Wallet/Assets/Fonts#Barlow Semi Condensed</FontFamily>
      <FontFamily x:Key="Mono">Cascadia Mono, Consolas, monospace</FontFamily>

      <!-- Fluent's accent (ticked boxes, progress) is the visitor's own decision colour: Exit Orange. -->
      <Color x:Key="SystemAccentColor">#c8401c</Color>
      <Color x:Key="SystemAccentColorDark1">#a93514</Color>
      <Color x:Key="SystemAccentColorDark2">#8f2d11</Color>
      <Color x:Key="SystemAccentColorDark3">#74240e</Color>
      <Color x:Key="SystemAccentColorLight1">#d8603f</Color>
      <Color x:Key="SystemAccentColorLight2">#e47f62</Color>
      <Color x:Key="SystemAccentColorLight3">#ef9f86</Color>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource Body}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>

    <!-- text -->
    <Style Selector="TextBlock.h1">
      <Setter Property="FontFamily" Value="{StaticResource SignFace}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="24" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontFamily" Value="{StaticResource SignFace}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="18" />
    </Style>
    <Style Selector="TextBlock.host">
      <Setter Property="FontFamily" Value="{StaticResource SignFace}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="21" />
    </Style>
    <Style Selector="TextBlock.figure">
      <Setter Property="FontFamily" Value="{StaticResource SignFace}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="17" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource Ink2}" />
    </Style>
    <Style Selector="TextBlock.strong">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="FontSize" Value="13.5" />
    </Style>
    <Style Selector="TextBlock.small">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="{StaticResource Mono}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{StaticResource Sign}" />
    </Style>
    <Style Selector="TextBlock.wrap">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- buttons: Allow and Show are Exit Orange; Decline is enamel with a grey border; links are sign blue -->
    <Style Selector="Button">
      <Setter Property="FontFamily" Value="{StaticResource Body}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="14.5" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.allow">
      <Setter Property="Background" Value="{StaticResource SignalDeep}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.allow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SignalDark}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.allow:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SignalDark}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.allow:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ChipGrey}" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style Selector="Button.deny">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="BorderBrush" Value="{StaticResource DenyBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.deny:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Ink2}" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
    <Style Selector="Button.deny:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Field}" />
      <Setter Property="BorderBrush" Value="{StaticResource Ink2}" />
    </Style>
    <Style Selector="Button.manager">
      <Setter Property="Background" Value="{StaticResource Sign}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.manager:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SignHover}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.small">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="11,6" />
    </Style>
    <Style Selector="Button.square">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="2,1" />
      <Setter Property="Foreground" Value="{StaticResource Sign}" />
      <Setter Property="FontSize" Value="13.5" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource SignalDark}" />
    </Style>
    <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource SignalDark}" />
    </Style>
    <Style Selector="Button.link.under TextBlock">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
    <Style Selector="Button.close">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource Ink2}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Field}" />
    </Style>

    <!-- surfaces -->
    <Style Selector="Border.popup">
      <Setter Property="Background" Value="White" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BoxShadow" Value="0 0 0 1 #1A13151B, 0 18 40 -16 #8C13151B, 0 6 14 -8 #4D13151B" />
      <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <Style Selector="Border.notice">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BoxShadow" Value="0 0 0 1 #2913151B, 0 18 40 -16 #8C13151B, 0 6 14 -8 #4D13151B" />
    </Style>
    <Style Selector="Border.row">
      <Setter Property="BorderBrush" Value="{StaticResource WinRule}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,7,10,8" />
    </Style>
    <Style Selector="Border.field">
      <Setter Property="Background" Value="{StaticResource Field}" />
      <Setter Property="BorderBrush" Value="{StaticResource WinRule}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="11,9" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource WinRule}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,14" />
    </Style>
    <Style Selector="Border.manager">
      <Setter Property="Background" Value="{StaticResource Field}" />
      <Setter Property="BorderBrush" Value="{StaticResource Sign}" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="11,10" />
    </Style>
    <Style Selector="Border.tile">
      <Setter Property="Background" Value="{StaticResource Sign}" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="Background" Value="{StaticResource ChipGrey}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.chip TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.chip.orange">
      <Setter Property="Background" Value="{StaticResource SignalDeep}" />
    </Style>
    <Style Selector="Border.chip.orange TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.chip.ink">
      <Setter Property="Background" Value="{StaticResource Ink}" />
    </Style>
    <Style Selector="Border.chip.ink TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.chip.outline">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource Outline}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.chip.outline TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Ink2}" />
    </Style>
    <Style Selector="Border.tag">
      <Setter Property="Background" Value="{StaticResource Field}" />
      <Setter Property="BorderBrush" Value="{StaticResource WinRule}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="6,2" />
    </Style>
    <Style Selector="Border.rule">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{StaticResource WinRule}" />
    </Style>

    <!-- the settings sidebar -->
    <Style Selector="ListBox.sidebar">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- a menu item answers the mouse: a grey wash under the pointer, darker while pressed; the open page is sign-blue -->
    <Style Selector="ListBox.sidebar ListBoxItem">
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="Margin" Value="8,2" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="14.5" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#e1e5ee" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#d3d8e4" />
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#dbe2f7" />
      <Setter Property="Foreground" Value="{StaticResource Sign}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#cdd7f4" />
      <Setter Property="Foreground" Value="{StaticResource Sign}" />
    </Style>

    <Style Selector="ProgressBar.meter">
      <Setter Property="Foreground" Value="{StaticResource Sign}" />
      <Setter Property="Background" Value="#e3e6ec" />
      <Setter Property="MinHeight" Value="6" />
      <Setter Property="Height" Value="6" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>
  </Application.Styles>
</Application>
