<Project Sdk="Microsoft.NET.Sdk">

  <!-- The sources of the wallet: a model in a program on this computer (Llama, LM Studio, Ollama, any OpenAI-compatible
       server) for text and for speech, and OpenRouter (an API key, paid). The wallet holds no model of its own. -->
  <PropertyGroup>
    <RootNamespace>Byoa.Wallet.Providers</RootNamespace>
    <AssemblyName>Byoa.Wallet.Providers</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Byoa.Wallet.Core\Byoa.Wallet.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Byoa.Wallet.Tests" />
  </ItemGroup>

  <!-- 0.1 is Windows first (DPAPI, the tray, the native host registration). -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
