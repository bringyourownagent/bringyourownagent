<Project Sdk="Microsoft.NET.Sdk">

  <!-- The wallet's logic without any UI: the wire protocol, the engine (grants, limits, the gate, routing),
       settings, the sealed secret store (DPAPI, Keychain, Secret Service) and WAV measuring. Shared by the desktop app,
       the native host and the tests. -->
  <PropertyGroup>
    <RootNamespace>Byoa.Wallet</RootNamespace>
    <AssemblyName>Byoa.Wallet.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BringYourOwnAgent" Version="0.0.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <!-- The Linux Secret Service (org.freedesktop.secrets), for the key of the sealed files. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Byoa.Wallet.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Help\*.md" LogicalName="Byoa.Wallet.Help.%(Filename).md" />
  </ItemGroup>

</Project>
