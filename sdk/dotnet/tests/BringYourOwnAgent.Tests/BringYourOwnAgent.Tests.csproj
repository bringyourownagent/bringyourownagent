<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A plain console runner, no test framework: it exits with 1 when any test fails.
      dotnet run -c Release -f net8.0                            the net8.0 build of the library
      dotnet run -c Release -f net8.0 -p:TestNetStandard=true    the netstandard2.0 build, on .NET 8
      dotnet run -c Release -f net48                             the netstandard2.0 build, on .NET Framework (Windows only)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net8.0;net48</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>BringYourOwnAgent.Tests</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TestNetStandard)' == 'true'">
    <OutputPath>bin\netstandard-library\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\netstandard-library\$(Configuration)\</IntermediateOutputPath>
    <DefineConstants>$(DefineConstants);TEST_NETSTANDARD</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(TestNetStandard)' != 'true'">
    <ProjectReference Include="..\..\src\BringYourOwnAgent\BringYourOwnAgent.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TestNetStandard)' == 'true'">
    <ProjectReference Include="..\..\src\BringYourOwnAgent\BringYourOwnAgent.csproj" SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

</Project>
