<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>BringYourOwnAgent.Relay</RootNamespace>
    <AssemblyName>BringYourOwnAgent.Relay</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>BringYourOwnAgent.Relay</PackageId>
    <Version>0.0.2</Version>
    <Authors>ultrathinker</Authors>
    <Description>The site's side of the BYOA «direct» link, ready-made for an ASP.NET Core site: the one-time codes of the bringyourownagent:// link, the WebSocket the visitor's agent wallet dials into, and the job relay a page polls. No accounts, no database, nothing kept but the live connections.</Description>
    <PackageTags>byoa;bring-your-own-agent;ai;agents;agent-wallet;relay;websocket;aspnetcore</PackageTags>
    <PackageProjectUrl>https://bringyourownagent.org</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bringyourownagent/bringyourownagent</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/bringyourownagent/bringyourownagent/blob/main/sdk/CHANGELOG.md</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- A site is an ASP.NET Core app: the relay speaks its WebSockets and its endpoints, and needs nothing else. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>